{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    { "name": "gcc-debug", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "gcc-release", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "clang-debug", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "clang-release", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "gcc-asan",
      "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "JGUI_SANITIZE": "ON" }
    },
    {
      "name": "gcc-warn",
      "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "JGUI_WARNINGS_ONLY": "ON" }
    },
    {
      "name": "clang-fuzz",
      "inherits": "clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "JGUI_FUZZ": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "gcc-asan", "configurePreset": "gcc-asan" },
    { "name": "gcc-warn", "configurePreset": "gcc-warn" },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz" }
  ],
  "testPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "gcc-asan", "configurePreset": "gcc-asan", "output": { "outputOnFailure": true } },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz", "output": { "outputOnFailure": true } }
  ]
}
